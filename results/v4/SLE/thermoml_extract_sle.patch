+# --------------------------------------------------------------------------------------------
+# --sle mode: solid-liquid equilibrium (liquidus) temperatures.  Separate code path; the default
+# mode (WANTED whitelist, parse_file, phase_of) is untouched.
+# Real-record facts (checked on 10.1007/s10765-010-0792-y.xml and the whole 2020-09-30 archive):
+#   * property name 'Solid-liquid equilibrium temperature, K' sits in Property-MethodID/PropertyGroup/PhaseTransition
+#   * the phase tags in real records are eVarPhase (Variable) / eConstraintPhase (Constraint) / ePhase (PhaseID);
+#     the default-mode helper phase_of() only looks for 'ePhase' and therefore never sees the first two.  SLE mode
+#     reads any descendant whose tag ends in 'Phase'.
+#   * PhaseID blocks list Liquid and the crystallising solid(s) (with RegNum); the solid(s) are recorded in `crystal_ids`.
+#   * ePresentation may be 'Difference with the reference state' (a depression, not an absolute T): such rows are kept
+#     but flagged (presentation column) and must not be used as liquidus temperatures.
+SLE_PROP = "Solid-liquid equilibrium temperature, K"
+
+
+def any_phase(parent, wrapper):
+    """Text of the first descendant of a <wrapper> child whose tag ends with 'Phase' (ePhase, eVarPhase, eConstraintPhase)."""
+    for w in kids(parent, wrapper):
+        for e in w.iter():
+            if ln(e).endswith("Phase") and ln(e).startswith("e") and e.text and e.text.strip():
+                return e.text.strip()
+    return None
+
+
+def parse_file_sle(root, fname: str, stats: collections.Counter):
+    compounds = {}
+    for c in kids(root, "Compound"):
+        compounds[first_text(c, "nOrgNum")] = dict(inchi=first_text(c, "sStandardInChI"), name=first_text(c, "sCommonName"))
+    rows = []
+    for d in kids(root, "PureOrMixtureData"):
+        ids = [first_text(c, "nOrgNum") for c in kids(d, "Component")]
+        props = {}
+        for p in kids(d, "Property"):
+            pn = first_text(p, "ePropName") or ""
+            if pn == SLE_PROP:
+                props[first_text(p, "nPropNumber")] = (pn, first_text(p, "ePresentation"), first_text(p, "ePropPhase"))
+        if not props:
+            continue
+        crystal_ids = []
+        for ph in kids(d, "PhaseID"):
+            t = first_text(ph, "ePhase")
+            if t and t.strip().lower().startswith("crystal"):
+                rn = [first_text(r, "nOrgNum") for r in kids(ph, "RegNum")]
+                crystal_ids.extend(rn if rn else ["?"])
+        defs, consts = {}, []
+        for v in kids(d, "Variable"):
+            vid = kids(v, "VariableID")
+            kind, text = type_of(vid[0]) if vid else (None, None)
+            defs[first_text(v, "nVarNumber")] = (kind, text, first_text(v, "nOrgNum"), any_phase(v, "VarPhaseID"))
+        for c in kids(d, "Constraint"):
+            cid = kids(c, "ConstraintID")
+            kind, text = type_of(cid[0]) if cid else (None, None)
+            consts.append((kind, text, first_text(c, "nOrgNum"), to_float(first_text(c, "nConstraintValue")),
+                           any_phase(c, "ConstraintPhaseID")))
+        for nv in kids(d, "NumValues"):
+            state, comp = {}, {}
+            for kind, text, org, val, ph in consts:
+                _assign(state, comp, kind, text, org, val, ph)
+            for vv in kids(nv, "VariableValue"):
+                kind, text, org, ph = defs.get(first_text(vv, "nVarNumber"), (None, None, None, None))
+                _assign(state, comp, kind, text, org, to_float(first_text(vv, "nVarValue")), ph)
+            for pv in kids(nv, "PropertyValue"):
+                if first_text(pv, "nPropNumber") not in props:
+                    continue
+                pname, pres, pphase = props[first_text(pv, "nPropNumber")]
+                val = to_float(first_text(pv, "nPropValue"))
+                if val is None:
+                    stats["sle: no numeric value"] += 1
+                    continue
+                n = len(ids)
+                c = dict(comp)
+                if n == 1:
+                    stats["sle: pure component (dropped)"] += 1
+                    continue
+                if state.get("bad_comp") or len(state.get("scales", ())) != 1:
+                    stats["sle: unsupported/ambiguous composition scale"] += 1
+                    continue
+                scale = next(iter(state["scales"]))
+                if len(c) == n - 1:
+                    missing = [i for i in ids if i not in c]
+                    rest = 1.0 - sum(c.values())
+                    if len(missing) != 1 or rest < -1e-6:
+                        stats["sle: inconsistent composition"] += 1
+                        continue
+                    c[missing[0]] = max(rest, 0.0)
+                elif len(c) != n:
+                    stats["sle: composition incomplete"] += 1
+                    continue
+                rows.append(dict(file=fname, prop=pname, prop_phase=pphase, presentation=pres, value=val,
+                                 T_K=state.get("T"), P_kPa=state.get("P"), ids=ids, comp=c, comp_type=scale,
+                                 crystal_ids=crystal_ids))
+    return compounds, rows
+
