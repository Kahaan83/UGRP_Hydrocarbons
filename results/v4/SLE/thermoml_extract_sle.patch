+def main_sle(a):
+    path = Path(a.archive) if a.archive else next(Path("data/raw/thermoml").glob("*.tgz"), None)
+    if path is None or not path.exists():
+        sys.exit("No ThermoML archive found. Run fetch.py thermoml or place the .tgz in data/raw/thermoml/")
+    out, n_files, n_bad = [], 0, 0
+    stats: collections.Counter = collections.Counter()
+    for fname, blob in iter_xml(path):
+        n_files += 1
+        if b"Solid-liquid equilibrium temperature" not in blob:
+            continue
+        try:
+            root = ET.parse(io.BytesIO(blob)).getroot()
+            comps, rows = parse_file_sle(root, fname, stats)
+        except Exception:  # noqa: BLE001
+            n_bad += 1
+            continue
+        for r in rows:
+            if not (r["ids"] and all(hc_inchi(comps.get(i, {}).get("inchi")) for i in r["ids"])):
+                stats["sle: not all-hydrocarbon / no InChI"] += 1
+                continue
+            out.append(dict(
+                file=r["file"], prop=r["prop"], prop_phase=r["prop_phase"], presentation=r["presentation"], value=r["value"],
+                T_K=r["T_K"], P_kPa=r["P_kPa"], n_comp=len(r["ids"]),
+                inchis=json.dumps([comps[i]["inchi"] for i in r["ids"]]),
+                names=json.dumps([comps[i]["name"] for i in r["ids"]]), comp_type=r["comp_type"],
+                comp_values=json.dumps([r["comp"].get(i) for i in r["ids"]]),
+                crystal_inchis=json.dumps([comps.get(i, {}).get("inchi") for i in r["crystal_ids"]]),
+                crystal_names=json.dumps([comps.get(i, {}).get("name") for i in r["crystal_ids"]])))
+    df = pd.DataFrame(out)
+    OUT_SLE.parent.mkdir(parents=True, exist_ok=True)
+    df.to_csv(OUT_SLE, index=False)
+    print(f"files read: {n_files}  errors: {n_bad}  SLE hydrocarbon rows kept: {len(df)}")
+    if len(df):
+        print(df.groupby(["n_comp", "presentation"], dropna=False).size().to_string())
+    print("\nrows NOT kept, by reason:")
+    for k, v in stats.most_common():
+        print(f"  {v:>9}  {k}")
+
+
